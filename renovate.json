{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "vulnerabilityAlerts": {"enabled": true, "schedule": ["at any time"]},
  "packageRules": [
    {"matchDepNames": ["node"], "matchManagers": ["nvm", "node-version", "dockerfile", "npm", "github-actions"], "groupName": "node runtime", "schedule": ["at any time"], "allowedVersions": "/^(22|24|26)\\./"}
  ]
}
